<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    const pageTitle = typeof title !== 'undefined' ? title + ' — Диспетчер' : 'Диспетчер — грузоперевозки по России';
    const pageDescription = typeof description !== 'undefined' ? description : 'Грузоперевозки по России от 200 кг. Расчёт за 2 минуты, 500+ проверенных перевозчиков, полное сопровождение.';
    const pagePath = typeof canonical !== 'undefined' && canonical ? canonical : '/';
    const robotsValue = typeof robots !== 'undefined' ? robots : 'index, follow';
    const siteDomain = process.env.DOMAIN || 'https://ai-dispatcher.ru';
    const socialImageUrl = `${siteDomain}/public/images/og-image.png`;
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <% if (process.env.GOOGLE_SITE_VERIFICATION) { %>
    <meta name="google-site-verification" content="<%= process.env.GOOGLE_SITE_VERIFICATION %>">
  <% } %>
  <% if (process.env.YANDEX_VERIFICATION) { %>
    <meta name="yandex-verification" content="<%= process.env.YANDEX_VERIFICATION %>">
  <% } %>
  <% if (typeof keywords !== 'undefined') { %><meta name="keywords" content="<%= keywords %>"><% } %>
  <meta name="robots" content="<%= robotsValue %>">
  <% if (typeof canonical !== 'undefined' && canonical) { %>
    <link rel="canonical" href="https://ai-dispatcher.ru<%= canonical %>">
    <link rel="alternate" hreflang="ru-RU" href="https://ai-dispatcher.ru<%= canonical %>">
    <link rel="alternate" hreflang="x-default" href="https://ai-dispatcher.ru<%= canonical %>">
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="Диспетчер">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Диспетчер — грузоперевозки по России' %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= siteDomain %><%= pagePath %>">
  <meta property="og:image" content="<%= socialImageUrl %>">
  <meta property="og:image:secure_url" content="<%= socialImageUrl %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Логотип сервиса Диспетчер">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Диспетчер — грузоперевозки по России' %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="<%= socialImageUrl %>">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/svg+xml" href="/yandex-icon.svg" sizes="120x120">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Диспетчер">
  <link rel="manifest" href="/site.webmanifest">

  <!-- LLM-оптимизация (GEO) -->
  <link rel="alternate" type="text/plain" href="https://ai-dispatcher.ru/llms.txt" title="LLM Navigation">
  <link rel="alternate" type="text/plain" href="https://ai-dispatcher.ru/llms-full.txt" title="LLM Full Content">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Onest:wght@300;400;500;600&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Onest:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/public/css/style.css">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TransportationService",
    "name": "Диспетчер",
    "url": "https://ai-dispatcher.ru",
    "description": "Грузоперевозки по России от 200 кг. Межгородние перевозки с подбором проверенного перевозчика и сопровождением заявки.",
    "areaServed": { "@type": "Country", "name": "Россия" },
    "serviceType": "Грузоперевозки",
    "email": "info@ai-dispatcher.ru",
    "sameAs": ["https://t.me/ai_dispatcherBot"],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "url": "https://t.me/ai_dispatcherBot",
      "availableLanguage": "Russian"
    }
  }
  </script>
  <% if (typeof canonical !== 'undefined' && canonical && canonical !== '/') {
    const breadcrumbNames = {
      '/uslugi': 'Услуги',
      '/stoimost-gruzoperevozki': 'Стоимость',
      '/gruzoperevozki-mezhgorod': 'Межгород',
      '/o-kompanii': 'О компании',
      '/kontakty': 'Контакты',
      '/blog': 'Блог'
    };
    const pageName = breadcrumbNames[canonical] || (typeof title !== 'undefined' ? title : '');
    const isBlog = canonical.startsWith('/blog/');
    const items = [{ name: 'Главная', url: 'https://ai-dispatcher.ru/' }];
    if (isBlog) {
      items.push({ name: 'Блог', url: 'https://ai-dispatcher.ru/blog' });
      items.push({ name: pageName, url: 'https://ai-dispatcher.ru' + canonical });
    } else if (pageName) {
      items.push({ name: pageName, url: 'https://ai-dispatcher.ru' + canonical });
    }
  %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": items.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": item.name,
      "item": item.url
    }))
  }) %>
  </script>
  <% } %>

  <!-- Yandex.Metrica counter -->
  <script type="text/javascript">
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
    window.dataLayer = window.dataLayer || [];

    ym(107026465, "init", {
      clickmap: true,
      trackLinks: true,
      accurateTrackBounce: true,
      webvisor: true,
      ecommerce: "dataLayer"
    });
  </script>
</head>
