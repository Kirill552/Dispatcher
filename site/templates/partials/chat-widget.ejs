<!-- Chat Widget -->
<button class="chat-fab" aria-label="Открыть чат">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
  </svg>
  <span class="chat-fab__badge">1</span>
</button>

<div class="chat-panel" aria-label="Чат с диспетчером">
  <div class="chat-panel__header">
    <div>
      <div class="chat-panel__title">Диспетчер</div>
      <div class="chat-panel__subtitle">Обычно отвечаем за 1 минуту</div>
    </div>
    <button class="chat-panel__close" aria-label="Закрыть чат">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <div class="chat-panel__body">
    <div class="chat-msg chat-msg--bot">Здравствуйте! Подскажите, что нужно перевезти? Помогу рассчитать стоимость.</div>
  </div>
  <div class="chat-panel__input">
    <input type="text" placeholder="Напишите сообщение..." aria-label="Сообщение">
    <button class="chat-panel__send" aria-label="Отправить">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </div>
</div>

<script src="/public/js/main.js"></script>
</body>
</html>
