        </div>
        <div class="counter">
          <span class="counter__value" data-target="50">0</span><span class="counter__suffix">+</span>
          <span class="counter__label">городов</span>
        </div>
        <div class="counter">
          <span class="counter__value" data-target="24">0</span><span class="counter__suffix">/7</span>
          <span class="counter__label">на связи</span>
        </div>
