            <label for="weight">Вес, кг</label>
            <input type="number" id="weight" name="weight" placeholder="от 200" min="200">
          </div>
          <div class="form-group">
            <label for="date">Дата загрузки</label>
            <input type="date" id="date" name="date">
          </div>
        </div>
        <button type="submit" class="btn btn--accent btn--full btn--lg">Рассчитать стоимость</button>
      </form>
    </div>
  </div>

  <div class="hero__counters">
    <div class="container">
      <div class="counters">
        <div class="counter">
          <span class="counter__value" data-target="500">0</span><span class="counter__suffix">+</span>
          <span class="counter__label">перевозчиков</span>
        </div>
        <div class="counter">
          <span class="counter__value" data-target="10">0</span><span class="counter__suffix"> лет</span>
