          Написать в Telegram
        </a>
        <a href="#how" class="btn btn--outline-light btn--lg">Как это работает</a>
      </div>
    </div>

    <div class="quote-form" id="quote">
      <h3 class="quote-form__title">Быстрый расчёт</h3>
      <p class="quote-form__subtitle">Заполните форму — диспетчер ответит за 2 минуты</p>
      <form>
        <div class="form-group">
          <label for="from">Откуда</label>
          <input type="text" id="from" name="from" placeholder="Город отправления" required>
        </div>
        <div class="form-group">
          <label for="to">Куда</label>
          <input type="text" id="to" name="to" placeholder="Город доставки" required>
