<%- include('partials/head', {
  title: 'Контакты',
  description: 'Свяжитесь с нами: Telegram, email, форма обратной связи. Диспетчер ответит за 2 минуты.',
  canonical: '/kontakty',
  keywords: 'контакты грузоперевозки, связаться диспетчер'
}) %>
<%- include('partials/nav', { currentPage: 'kontakty' }) %>

<div class="page-header">
  <div class="container">
    <h1 class="reveal">Контакты</h1>
    <p class="lead reveal reveal--delay-1">Свяжитесь удобным способом — диспетчер ответит за 2 минуты.</p>
  </div>
  <div class="wave-divider">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0,40 C360,80 720,0 1440,40 L1440,80 L0,80 Z" fill="#ffffff"/>
    </svg>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="contact-item">
          <div class="contact-item__icon">💬</div>
          <div>
            <div class="contact-item__label">Telegram — основной канал</div>
            <div class="contact-item__value">
              <a href="https://t.me/ai_dispatcher_bot" target="_blank" rel="noopener">@ai_dispatcher_bot</a>
            </div>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon">✉️</div>
          <div>
            <div class="contact-item__label">Email</div>
            <div class="contact-item__value">
              <a href="mailto:info@ai-dispatcher.ru">info@ai-dispatcher.ru</a>
            </div>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon">🕐</div>
          <div>
            <div class="contact-item__label">Режим работы</div>
            <div class="contact-item__value">24/7 без выходных</div>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon">🗺️</div>
          <div>
            <div class="contact-item__label">География</div>
            <div class="contact-item__value">Вся Россия, 50+ городов</div>
          </div>
        </div>

        <div style="margin-top: var(--sp-lg); padding: var(--sp-xl); background: var(--c-navy-50); border-radius: var(--r-lg);">
          <h4 style="font-family: var(--f-display); font-size: var(--fs-body); margin-bottom: var(--sp-sm);">Самый быстрый способ</h4>
          <p style="font-size: var(--fs-small); color: var(--c-gray-500); margin-bottom: var(--sp-md);">Напишите в Telegram — диспетчер ответит за 1-2 минуты и сразу рассчитает стоимость.</p>
          <a href="https://t.me/ai_dispatcher_bot" class="btn btn--accent" target="_blank" rel="noopener">Открыть Telegram</a>
        </div>
      </div>

      <div class="contact-form reveal reveal--delay-1">
        <h3 style="font-family: var(--f-display); font-size: var(--fs-h3); margin-bottom: var(--sp-lg);">Написать нам</h3>
        <form>
          <div class="form-group">
            <label for="name">Имя</label>
            <input type="text" id="name" name="name" placeholder="Как к вам обращаться?" required>
          </div>
          <div class="form-group">
            <label for="contact">Телефон или email</label>
            <input type="text" id="contact" name="contact" placeholder="Для обратной связи">
          </div>
          <div class="form-group">
            <label for="message">Сообщение</label>
            <textarea id="message" name="message" rows="4" placeholder="Опишите ваш вопрос или груз..." style="resize: vertical;"></textarea>
          </div>
          <button type="submit" class="btn btn--accent btn--full btn--lg">Отправить</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/chat-widget') %>
