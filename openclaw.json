{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/minimax/minimax-m2.5"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "streamMode": "block"
    }
  },
  "commands": {
    "allowFrom": { "408001372": ["*"] }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18790,
    "auth": {
      "mode": "token",
      "token": "GENERATE_WITH_openssl_rand_-hex_32"
    },
    "http": {
      "endpoints": {
        "chatCompletions": { "enabled": true },
        "responses": { "enabled": true }
      }
    }
  },
  "tools": {
    "exec": {
      "security": "deny"
    }
  },
  "skills": {
    "load": {
      "extraDirs": [".agents/skills"]
    },
    "entries": {
      "dispatcher-client": { "enabled": true },
      "dispatcher-admin": { "enabled": true },
      "clawhub": { "enabled": false }
    }
  },
  "plugins": {
    "slots": { "memory": "memory-lancedb" },
    "entries": {
      "memory-lancedb": {
        "enabled": true,
        "config": {
          "embedding": {
            "apiKey": "${OPENROUTER_API_KEY}",
            "model": "text-embedding-3-small",
            "baseUrl": "https://openrouter.ai/api/v1"
          },
          "autoCapture": false,
          "autoRecall": true
        }
      },
      "tenant-memory": {
        "enabled": true,
        "config": {
          "embeddingApiKey": "${OPENROUTER_API_KEY}",
          "embeddingModel": "openai/text-embedding-3-small",
          "embeddingBaseUrl": "https://openrouter.ai/api/v1",
          "dataPath": "/home/node/.openclaw/tenant-memory",
          "adminUserId": "408001372",
          "maxRecallResults": 5
        }
      },
      "ati-cargo": {
        "enabled": true,
        "config": {
          "apiToken": "${ATI_API_TOKEN}",
          "boardId": "",
          "monitorIntervalMs": 30000
        }
      },
      "rbac": {
        "enabled": true,
        "config": {
          "roles": {
            "admin": {
              "users": ["408001372"],
              "channels": "*",
              "tools": "*"
            },
            "guest": {
              "users": "*",
              "channels": "*",
              "tools": [
                "ati_city_search",
                "ati_detect_payment_type",
                "ati_mock_status",
                "ati_create_cargo",
                "ati_check_responses",
                "ati_get_new_responses",
                "ati_carrier_info",
                "memory_search",
                "tenant_save",
                "tenant_recall",
                "analytics_log",
                "telegram_notify"
              ]
            }
          },
          "defaultRole": "guest",
          "logBlocked": true,
          "logAllowed": false,
          "failSafe": "deny",
          "rateLimit": {
            "maxBlockedPerMinute": 30,
            "action": "suppress-logs"
          },
          "systemCommands": {
            "mode": "allowlist",
            "allowed": ["/start"],
            "guestHelp": "🚛 Я — диспетчер грузоперевозок по России!\n\n📦 Принимаю грузы от 200 кг\n🗺️ Межгород по всей России\n⏱ Подбор перевозчика за 15-30 минут\n\nПросто напишите что и куда нужно перевезти — или отправьте голосовое сообщение!",
            "blockResponse": "🚛 Я — диспетчер грузоперевозок!\n\nЭта команда мне не знакома. Просто напишите что и куда нужно перевезти — я помогу найти перевозчика и рассчитать стоимость 📦"
          }
        }
      },
      "lead-pipeline": {
        "enabled": true,
        "config": {
          "vkToken": "${VK_COMMUNITY_TOKEN}",
          "vkGroupIds": [],
          "telegramBotToken": "${TELEGRAM_BOT_TOKEN}",
          "notifyUserId": "408001372",
          "botUsername": "${TELEGRAM_BOT_USERNAME}",
          "sheetsId": "${GOOGLE_SHEETS_ID}",
          "sheetsServiceAccountJson": "${GOOGLE_SERVICE_ACCOUNT_JSON}",
          "openrouterApiKey": "${OPENROUTER_API_KEY}",
          "pollIntervalMs": 300000,
          "vkCommentDailyLimit": 20
        }
      }
    }
  }
}
