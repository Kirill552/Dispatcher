{
  "schedules": {
    "smoke_test": {
      "enabled": true,
      "cron": "0 2 * * *",
      "description": "Ежедневный smoke test - быстрая проверка основного функционала"
    },
    "comprehensive_test": {
      "enabled": true,
      "cron": "0 3 * * 0",
      "description": "Еженедельный полный тест - детальная проверка всех компонентов"
    },
    "stress_test": {
      "enabled": false,
      "cron": "0 4 1 * *",
      "description": "Ежемесячный стресс-тест - проверка производительности под нагрузкой"
    }
  },
  "notifications": {
    "enabled": false,
    "email": {
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "sender_email": "",
      "sender_password": "",
      "recipients": [
        "admin@company.com",
        "dev@company.com"
      ]
    },
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": ""
    }
  },
  "retention": {
    "keep_results_days": 30,
    "max_results_files": 100
  },
  "thresholds": {
    "smoke_test_min_success_rate": 0.9,
    "comprehensive_test_min_success_rate": 0.8,
    "stress_test_min_success_rate": 0.7
  },
  "test_settings": {
    "timeout_seconds": 300,
    "retry_failed_tests": true,
    "max_retries": 2,
    "parallel_execution": false,
    "mock_delays_enabled": true,
    "detailed_logging": true
  },
  "mock_configuration": {
    "api_delay_simulation": true,
    "api_delay_min": 0.1,
    "api_delay_max": 2.0,
    "failure_simulation": false,
    "failure_rate": 0.05,
    "network_timeout_simulation": false
  },
  "reporting": {
    "generate_html_reports": true,
    "include_conversation_logs": true,
    "include_performance_metrics": true,
    "screenshot_failures": false,
    "save_detailed_logs": true
  },
  "integration": {
    "slack_webhook": "",
    "jenkins_integration": false,
    "ci_cd_mode": false,
    "export_junit_xml": false
  }
} 