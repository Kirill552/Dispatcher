y.8631e8bbf713ee89ae8e.js\" async></script><script src=\"/dstatic/build/react-dom.a42574196f3298986d53.js\" async></script><script src=\"/dstatic/build/react-router.4e68820ef025aeb882cb.js\" async></script><script src=\"/dstatic/build/react-router-dom.89c7e3503f6afae2fea5.js\" async></script><script src=\"/dstatic/build/react-helmet.ca52e342f48808278f5f.js\" async></script><script src=\"/dstatic/build/stats.56e99fbb11e539bd8536.js\" async></script></head><body onbeforeunload=\"\"><div id=\"app\"><div class=\"styles-module-theme-22p1g styles-module-theme-1G3HG\"><div class=\"avito-header-wrapper-root-3j15K\"><div class=\"index-root-14r_P header-services\" data-marker=\"header/navbar\"><div class=\"index-inner-YWiS7\"><ul class=\"index-nav-3xZqC\"><li class=\"index-nav-item-2p2Bm\"><a class=\"index-nav-link-O0uuW\" href=\"https://www.avito.ru/business\">Для бизнеса</a></li><li class=\"index-nav-item-2p2Bm\"><a class=\"index-nav-link-O0uuW\" href=\"https://www.avito.ru/shops\">Магазины</a></li><li class=\"index-nav-item-2p2Bm\"><a class=\"index-nav-link-O0uuW\" href=\"//support.avito.ru\" rel=\"noopener noreferrer\" target=\"_blank\">Помощь</a></li></ul><div class=\"index-services-menu-3f4CD\"><div data-marker=\"header/favorites\" class=\"index-services-menu-item-31gvd\"><a class=\"index-services-menu-link-2UULV\" href=\"https://www.avito.ru/favorites\" title=\"Избранное\"><span class=\"index-services-menu-icon-wrap-1_nyX\"><span class=\"index-services-menu-icon-17erP\"><svg width=\"21\" height=\"24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10.918 5.085a5.256 5.256 0 0 1 7.524 0c2.077 2.114 2.077 5.541 0 7.655l-7.405 7.534a.75.75 0 0 1-1.074 0L2.558 12.74c-2.077-2.114-2.077-5.54 0-7.655a5.256 5.256 0 0 1 7.524 0c.15.152.289.312.418.479.13-.167.269-.327.418-.479z\" fill=\"#CCC\" fill-rule=\"nonzero\"></path></svg></span></span></a></div><div class=\"index-services-menu-item_username-tRpSY\"><a class=\"index-services-menu-link-2UULV index-services-menu-link-not-authenticated-1aH6k\" href=\"#login?authsrc=h\" data-marker=\"header/login-button\">Вход и регистрация</a></div></div><div class=\"index-add-button-wrapper-3K9pZ\"><a href=\"#login?next=https%3A%2F%2Fwww.avito.ru%2Fadditem&amp;authsrc=ca\" target=\"_self\" class=\"index-add-button-3w4EL button-button-2XjWo button-size-s-m4z8n button-primary-1QYIb\">Разместить объявление</a></div></div></div></div><div class=\"app-root-3Dlyv\"><div class=\"app-header-root-3UZOZ\"><a class=\"app-header-logo-3W2uh\" href=\"/\"></a></div><div class=\"layout-with-left-panel-layout-2P9Z5\"><div class=\"layout-with-left-panel-aside-1tWW6\"><nav class=\"left-menu-root-3RMBF\"></nav><div class=\"styles-module-root-2fM8s styles-module-margin-top_48-999pD styles-module-margin-bottom_none-2m0Vi styles-module-root_direction_vertical-AKhFP styles-module-root_fullWidth-32sRV\" style=\"--module-spacer-column-gap:var(--theme-gap-16);--module-spacer-row-gap:var(--theme-gap-16)\"><div class=\"styles-module-root-2Wgs1 styles-module-margin-top_none-3HqHf styles-module-margin-bottom_none-2m0Vi\" style=\"--module-spacer-slot-width:auto\"><div class=\"styles-module-root-2fM8s styles-module-margin-top_none-3HqHf styles-module-margin-bottom_none-2m0Vi styles-module-root_direction_vertical-AKhFP styles-module-root_fullWidth-32sRV\" style=\"--module-spacer-column-gap:var(--theme-gap-4);--module-spacer-row-gap:var(--theme-gap-4)\"><div class=\"styles-module-root-2Wgs1 styles-module-margin-top_none-3HqHf styles-module-margin-bottom_none-2m0Vi\" style=\"--module-spacer-slot-width:auto\"><span class=\"styles-module-noAccent-3k8e9\">Поддержка проф. инструментов</span></div><div class=\"styles-module-root-2Wgs1 styles-module-margin-top_none-3HqHf styles-module-margin-bottom_none-2m0Vi\" style=\"--module-spacer-slot-width:auto\"><span class=\"\">8 800 600-00-01</span></div><div class=\"styles-module-root-2Wgs1 styles-module-margin-top_none-3HqHf styles-module-margin-bottom_none-2m0Vi\" style=\"--module-spacer-slot-width:auto\"><a href=\"mailto:supportautoload@avito.ru\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K\">supportautoload@avito.ru</a></div></div></div><div class=\"styles-module-root-2Wgs1 styles-module-margin-top_none-3HqHf styles-module-margin-bottom_none-2m0Vi\" style=\"--module-spacer-slot-width:auto\"><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m-W6fg4 stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-1TYJP\"><a target=\"_blank\" href=\"https://support.avito.ru/request/334?eventData[articleId]=1397&amp;eventData[contextId]=102\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K\">Написать в поддержку</a><br/><span class=\"styles-module-noAccent-3k8e9\">Чтобы обращение рассмотрели быстрее, добавьте сURL запроса в описании проблемы</span></p></div></div></div><div><div class=\"page-content-container-root-1hI-8\"><h1 class=\"styles-module-root-1sIfM styles-module-root-2P3bc styles-module-size_xxxxl-XYQqy styles-module-size_xxxxl_dense-ZKrlw styles-module-size_xxxxl-mFRFg styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-header-4xl-23vBy styles-module-root_bottom-E0fRw styles-module-margin-bottom_24-3AJWq\">API и готовые модули для удобной работы с Авито</h1><h2 class=\"styles-module-root-1sIfM styles-module-root-2P3bc styles-module-size_xxxl-3aqNW styles-module-size_xxxl_dense-1XRiA styles-module-size_xxxl-2aznV styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-header-3xl-3rQH3\">Пользователям</h2><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m-W6fg4 stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-1TYJP styles-module-root_bottom-E0fRw styles-module-margin-bottom_20-1RPxv\">Вы можете проинтегрировать Авито с другими сервисами, которые используете в работе. Например, чтобы выкладывать объявления, общаться с клиентами и смотреть статистику через привычную CRM.<br/><br/>Для начала убедитесь, что у вас подключён один из платных тарифов: «Базовый», «Расширенный» или «Максимальный». Дальнейшие шаги зависят от того, с каким сервисом вы хотите настроить интеграцию.</p><div class=\"card-view-root-3ylGm\"><div class=\"card-root-1hrCw\"><h3 class=\"styles-module-root-1sIfM styles-module-root-2P3bc styles-module-size_xl-33O1M styles-module-size_xl_dense-3uaRw styles-module-size_xl-1JGjA styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-header-xl-1Pxyv\">Готовый сервис</h3><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m-W6fg4 stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-1TYJP\">Во многих сервисах уже можно получать данные от Авито по API, например в «Битрикс24», amoCRM, Jivo, Callibri и других.<br/><br/>Узнайте у службы поддержки системы, в которой вы работаете, есть ли такая возможность. Если да, вам помогут с настройкой.</p></div><div class=\"card-root-1hrCw\"><h3 class=\"styles-module-root-1sIfM styles-module-root-2P3bc styles-module-size_xl-33O1M styles-module-size_xl_dense-3uaRw styles-module-size_xl-1JGjA styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-header-xl-1Pxyv\">Сервис собственной разработки</h3><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m-W6fg4 stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-1TYJP\">Получите ключи в разделе<!-- --> <a href=\"https://www.avito.ru/professionals/api\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K\">«Для профессионалов» → «API»</a>, а затем отправьте их и ссылку на документацию своим разработчикам.</p></div></div><article><h2 class=\"styles-module-root-1sIfM styles-module-root-2P3bc styles-module-size_xxxl-3aqNW styles-module-size_xxxl_dense-1XRiA styles-module-size_xxxl-2aznV styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-header-3xl-3rQH3\">Разработчикам</h2><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m-W6fg4 stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-1TYJP\">Ваше приложение может получать данные от Авито через API. Полный список API вместе со всей документацией вы найдёте<!-- --> <a href=\"/api-catalog\"><span class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K\">в каталоге</span></a>. Чтобы приступить к интеграции, действуйте в такой последовательности:</p><ol class=\"styles-module-root-AS630 styles-module-root_size_m-g_DQn styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m_dense--nTVg styles-module-size_m-W6fg4 styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-dense-2hik0\"><li class=\"styles-module-root-td_U6 styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m_dense--nTVg styles-module-size_m-W6fg4 styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-dense-2hik0 styles-module-root_size_m-2j-yR styles-module-root_position_outside-3W3ru styles-module-root_list-type_ol-11q1v\"><a href=\"#login?authsrc=h\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K\">Зарегистрируйте своё приложение</a> <!-- -->и запросите доступ к нужному API.</li><li class=\"styles-module-root-td_U6 styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m_dense--nTVg styles-module-size_m-W6fg4 styles-module-size_dense-1kGLO stylesMarningNormal-module-root-3JQkg stylesMarningNormal-module-paragraph-m-dense-2hik0 styles-module-root_size_m-2j-yR styles-module-root_position_outside-3W3ru styles-module-root_list-type_ol-11q1v\">Дождитесь электронного письма с ключами.</li></ol></article></div><div class=\"app-footer-root-1OtIv\"><article><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m_dense--nTVg styles-module-size_m-W6fg4 styles-module-size_dense-1kGLO stylesMarginDense-module-root-23e9T stylesMarginDense-module-paragraph-m-dense-3IVDX\"><a target=\"_blank\" href=\"https://support.avito.ru/articles/200026948\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K styles-module-root_preset_black-3Fc54\">Условия использования Авито</a> ·<!-- --> <a target=\"_blank\" href=\"https://www.avito.ru/safety/personal/company\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K styles-module-root_preset_black-3Fc54\">Политика о данных пользователей</a> ·<!-- --> <a target=\"_blank\" href=\"/docs/APITermsOfServiceV1.pdf\" class=\"styles-module-root-2F9CP styles-module-root_noVisited-2IR6K styles-module-root_preset_black-3Fc54\">Условия использования API</a></p><p class=\"styles-module-root-2P3bc styles-module-size_m-1MVgE styles-module-size_m_dense--nTVg styles-module-size_m-W6fg4 styles-module-size_dense-1kGLO stylesMarginDense-module-root-23e9T stylesMarginDense-module-paragraph-m-dense-3IVDX styles-module-noAccent-3k8e9\">Авито — сайт объявлений России. © ООО «КЕХ еКоммерц» 2007–<!-- -->2025<!-- -->.</p></article></div></div></div></div></div></div><script>window.__initialData__ = \"%7B%22%40avito-core%2Ftoggles%3A6.1.8%22%3A%7B%22is_new_social_auth%22%3Afalse%2C%22recaptcha_enabled%22%3Atrue%2C%22securedtouch%22%3Atrue%2C%22securedtouch_test%22%3Atrue%2C%22yandex%22%3Afalse%2C%22ya_webvisor%22%3Afalse%7D%2C%22%40avito-core%2Fab-central%3A3.2.5%22%3A%7B%22Icebreaker_web_including_last_msg%22%3A%7B%22analyticParams%22%3A%7B%22ab%22%3A%2216653%3A2%3A-3%22%2C%22defaultEvent%22%3Atrue%7D%2C%22testGroup%22%3A%22test%22%7D%2C%22adding_nds_field_item_add%22%3A%7B%22analyticParams%22%3A%7B%22ab%22%3A%2223426%3A2%3A-3%22%2C%22defaultEvent%22%3Atrue%7D%2C%22testGroup%22%3A%22test%22%7D%2C%22adv_Q1_2026_services%22%3A%7B%22analyticParams%22%3A%7B%22ab%22%3A%2230156%3A1%3A10%22