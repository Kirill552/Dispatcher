# Основные настройки приложения
APP_NAME=ИИ-Диспетчер Логистики
DEBUG=True
TESTING=False

# База данных
DATABASE_URL=sqlite:///./logistics_ai.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+79XXXXXXXXX

# AI Services (OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ATI.SU Integration
ATI_API_KEY=your_ati_api_key_here
ATI_REFRESH_INTERVAL=300



# Рекламные API
GOOGLE_ADS_CREDENTIALS=path_to_google_ads_credentials.json

# Серверные настройки
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/logistics_ai.log

# Redis (для фоновых задач)
REDIS_URL=redis://localhost:6379

# Системные настройки
TIMEZONE=Europe/Moscow
MAX_CONCURRENT_REQUESTS=10

# ATI.SU API Configuration
ATI_API_TOKEN=your_ati_token_here
ATI_API_URL=https://api.ati.su/v1.0
ATI_API_TIMEOUT=30

# Telegram API (для мониторинга каналов, опционально)
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook

# Мониторируемые группы/каналы (через запятую)
MONITORED_CHATS=@gruzoperevozki_rf,@ati_su_cargo,@cargo_russia,@trucking_russia,@logistics_chat

# Database Configuration
DATABASE_ECHO=False

# Redis Configuration (для Celery)
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Business Configuration
DEFAULT_COMMISSION_PERCENT=40
MIN_ORDER_AMOUNT=5000
MAX_ORDER_AMOUNT=500000

# Monitoring Configuration
MONITORING_INTERVAL_SECONDS=300
MAX_CONCURRENT_ORDERS=50

# Contact Information
DISPATCHER_PHONE=+7XXXXXXXXXX
DISPATCHER_TELEGRAM=@your_telegram
DISPATCHER_EMAIL=dispatcher@yourdomain.com

# Advertising APIs (опционально)
GOOGLE_ADS_CREDENTIALS=path/to/google_ads_credentials.json

# Development Settings
DEBUG=True
TESTING=False

# === НОВАЯ СИСТЕМА AI МОДЕЛЕЙ ===

# СПЕЦИАЛИЗИРОВАННЫЕ МОДЕЛИ ПО ЗАДАЧАМ:

# ИИ-продажник (сложная логика, работа с возражениями)
# Рекомендуется: o3-2025-04-16 для лучшего качества продаж
AI_SALES_MODEL=o4-mini

# Простые задачи (извлечение данных, валидация, вопросы)
# Рекомендуется: gpt-4.1-mini для экономии
AI_SIMPLE_MODEL=gpt-4.1-mini-2025-04-14

# Анализ данных и диалогов
AI_ANALYSIS_MODEL=gpt-4.1-mini-2025-04-14

# Генерация текстов (уведомления, сообщения)
AI_TEXT_GENERATION_MODEL=gpt-4.1-mini-2025-04-14

# Диспетчерская логика (основная обработка заказов)
# Рекомендуется: o3 для критически важных решений
AI_DISPATCHER_MODEL=o4-mini

# Настройки для o3 (думающая модель)
# Включить гибкую обработку (дешевле в 2 раза)
O3_USE_FLEXIBLE_PROCESSING=true
# Время размышления: low, medium, high
O3_THINKING_TIME=medium

# ЭКОНОМИЯ ТОКЕНОВ - FLEX PROCESSING (СКИДКА 50%!)
# Включает гибкую обработку для o3 и o4-mini моделей
USE_FLEX_PROCESSING=true 